# ═══════════════════════════════════════════════════════════════════════════════
# ENVIRONMENT TEMPLATE — copy to .env.development / .env.staging / .env.production
# This file IS committed. It contains no real secrets.
# Put real secrets in .env.*.local (git-ignored).
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Identity ────────────────────────────────────────────────────────────────
VITE_APP_ENV=development                # development | staging | production
VITE_APP_URL=http://localhost:5173      # Public URL of this deployment
VITE_APP_DOMAIN=localhost               # Subdomain/domain
VITE_APP_NAME=IGK Learning Centre
VITE_APP_TAGLINE=Inspiring Global Knowledge
VITE_APP_VERSION=1.0.0                  # Injected by CI/CD
VITE_BUILD_TIMESTAMP=local              # Injected by CI/CD (ISO timestamp)

# ─── Backend ─────────────────────────────────────────────────────────────────
VITE_POCKETBASE_URL=http://127.0.0.1:8090  # DIFFERENT per environment — NEVER share

# ─── Observability ───────────────────────────────────────────────────────────
VITE_LOG_LEVEL=debug                    # debug | info | warn | error | silent
VITE_ERROR_TRACKING=false               # true in staging + production

# ─── Feature Flags ───────────────────────────────────────────────────────────
VITE_FF_SANDBOX_ROUTES=true             # /dev, /sandbox, /test/* — false in prod
VITE_FF_NEW_DASHBOARD=false             # Next-gen dashboard (beta)
VITE_FF_BETA_ENROLLMENT=false           # Beta self-enrollment flow
VITE_FF_LIVE_CHAT=false                 # Live chat widget
VITE_FF_VERBOSE_API=false               # Log full API bodies
VITE_FF_MAINTENANCE=false               # Maintenance mode banner
